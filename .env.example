# Public-facing environment variables (Vite exposes only VITE_* to the client)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEFAULT_MODEL=gpt-4.1
VITE_APP_NAME=AI Chatbot

# JWT used to authenticate against your backend (optional, depending on your auth flow)
# In production, prefer storing this in an http-only cookie set by your backend.
VITE_AUTH_TOKEN=
