PORT=8080
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000

# JWT used to validate Authorization: Bearer <token>. If empty, auth is skipped (dev only).
JWT_SECRET=

# Provider keys — only set the ones you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Local Llama (Ollama / llama.cpp / LM Studio — anything OpenAI-compatible).
# Ollama:        http://localhost:11434/v1
# llama.cpp:     http://localhost:8080/v1
# LM Studio:     http://localhost:1234/v1
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_API_KEY=ollama

# Optional rate limit (requests per minute per IP).
RATE_LIMIT_PER_MIN=60
